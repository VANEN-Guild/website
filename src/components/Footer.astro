---
import { getEntry } from 'astro:content';
import { img } from '../lib/images';
import { url } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
---

<footer class="site-footer" style={`--footer-bg: url('${img('footer.jpg').src}')`}>
  <div class="container inner">
    <span class="logo">{site.name}</span>
    <nav aria-label="Rechtliches">
      <ul>
        {site.footerNav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <p class="copy">© 1998–{new Date().getFullYear()} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: #000 var(--footer-bg) center top no-repeat;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    padding-block: 3.5rem 3rem;
    text-align: center;
  }

  .logo {
    font-family: var(--font-logo);
    font-size: 2rem;
    line-height: 1;
    color: #fff;
    text-shadow: 0 0 10px var(--glow);
    opacity: 0.85;
  }

  ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-left: 1px solid #555;
  }

  a {
    display: block;
    padding: 0 0.9rem;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    text-decoration: none;
  }

  a:hover {
    color: var(--cyan);
  }

  .copy {
    margin: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
