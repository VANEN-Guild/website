---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/dates';
import { url } from '../lib/url';

const site = (await getEntry('site', 'site'))!.data;
const entries = (await getCollection('games', ({ data }) => data.active)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'de'),
);
const games = await Promise.all(
  entries.map(async (game) => ({
    game,
    Content: (await render(game)).Content,
    news: (await getEntries(game.data.news))
      .filter((n) => !n.data.draft)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  })),
);
---

<PageLayout page="spiele">
  {games.length === 0 && <p class="empty">Gerade ist kein Spiel eingetragen. Schau im Discord vorbei, was wir planen.</p>}

  {
    games.map(({ game, Content, news }) => (
      <section id={game.id} class="game panel" aria-labelledby={`${game.id}-title`}>
        <header class="head">
          <div class="name">
            {game.data.logo && <Image class="logo" src={game.data.logo} alt="" height={160} />}
            <h2 id={`${game.id}-title`}>{game.data.title}</h2>
          </div>
          {game.data.recruiting && <span class="badge">Wir suchen Mitspieler:innen</span>}
        </header>

        {game.data.facts.length > 0 && (
          <dl class="facts">
            {game.data.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="prose">
          <Content />
        </div>

        {game.data.recruiting && (
          <div class="recruit">
            <p>{game.data.recruitingNote ?? 'Du möchtest mitspielen? Melde dich bei uns im Discord.'}</p>
            <a class="btn btn--primary" href={site.discord} target="_blank" rel="noopener noreferrer">
              <Icon name="discord" size={18} /> Join our Discord
            </a>
          </div>
        )}

        {news.length > 0 && (
          <div class="news">
            <h3 class="section-title">News zum Spiel</h3>
            <ul class="news-list">
              {news.map((entry) => (
                <li>
                  <a href={url(`/news/${entry.id}`)}>
                    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
                    <span class="title">{entry.data.title}</span>
                    <Icon name="arrow-right" size={16} />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    ))
  }
</PageLayout>

<style>
  .empty {
    margin-top: 2rem;
  }

  .game {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .name {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  /* Logo höchstens 5rem hoch, breite Schriftzüge dürfen breiter werden */
  .logo {
    flex: none;
    width: auto;
    max-width: min(10rem, 35vw);
    height: auto;
    max-height: 5rem;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgb(0 0 0 / 0.8));
  }

  @media (max-width: 640px) {
    .head {
      flex-direction: column;
    }

    .name {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }

    .logo {
      max-width: 12rem;
    }
  }

  .head h2 {
    margin: 0;
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    border: 1px solid rgb(0 255 255 / 0.5);
    border-radius: 999px;
    background: var(--cyan-soft);
    box-shadow: 0 0 14px -4px var(--glow);
  }

  /* pulsierender Punkt */
  .badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--glow);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge::before {
      animation: none;
    }
  }

  /* Flex statt Grid: die letzte Zeile füllt sich immer ganz, ohne leere Zellen */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0 0 1.75rem;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .facts div {
    flex: 1 1 8rem;
    padding: 0.8rem 1rem;
    background: rgb(0 0 0 / 0.55);
  }

  .facts dt {
    margin-bottom: 0.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 650;
    color: var(--text);
  }

  .recruit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-left: 2px solid var(--cyan);
    background: var(--cyan-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .recruit p {
    flex: 1 1 20rem;
    margin: 0;
    color: var(--text);
  }

  .news {
    margin-top: 2.5rem;
  }

  .news-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .news-list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .news-list a:hover {
    color: var(--cyan);
    background: var(--cyan-soft);
  }

  .news-list time {
    flex: none;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .news-list .title {
    flex: 1;
    font-weight: 600;
  }

  .news-list :global(.icon) {
    flex: none;
    align-self: center;
    color: var(--cyan);
    transition: transform 0.2s;
  }

  .news-list a:hover :global(.icon) {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .news-list a {
      flex-wrap: wrap;
      gap: 0.15rem 1rem;
    }

    .news-list time {
      flex-basis: 100%;
    }
  }
</style>
