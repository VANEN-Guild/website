---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

type Member = CollectionEntry<'members'>['data']['members'][number];

interface Props {
  member: Member;
}

const { member } = Astro.props;
const profile = member.discordId ? `https://discord.com/users/${member.discordId}` : undefined;
---

<article class="member panel">
  <header>
    <span class="initial" aria-hidden="true">{member.name.charAt(0).toUpperCase()}</span>
    <div>
      <h3>{member.name}</h3>
      {
        member.discord &&
          (profile ? (
            <a class="discord" href={profile} target="_blank" rel="noopener noreferrer">
              <Icon name="discord" size={14} />
              {member.discord}
              <span class="sr-only">(Discord-Profil)</span>
            </a>
          ) : (
            <span class="discord">
              <Icon name="discord" size={14} />
              {member.discord}
            </span>
          ))
      }
    </div>
  </header>

  {member.since && <p class="meta">dabei seit {member.since}</p>}
  {member.bio && <p class="bio">{member.bio}</p>}
  {
    member.games.length > 0 && (
      <ul class="games" aria-label="Spiele">
        {member.games.map((game) => <li>{game}</li>)}
      </ul>
    )
  }
</article>

<style>
  .member {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .initial {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--cyan);
    border-radius: 50%;
    background: #000;
    font-family: var(--font-logo);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--cyan);
    box-shadow: 0 0 10px -2px var(--glow);
  }

  h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .discord {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }

  a.discord:hover {
    color: var(--cyan);
  }

  .meta,
  .bio {
    margin: 0;
  }

  .bio {
    font-size: 0.95rem;
  }

  .games {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .games li {
    padding: 0.15rem 0.55rem;
    font-size: 0.75rem;
    color: var(--text-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
