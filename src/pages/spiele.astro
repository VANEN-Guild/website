---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import Icon from '../components/Icon.astro';

const site = (await getEntry('site', 'site'))!.data;
const entries = (await getCollection('games', ({ data }) => data.active)).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'de'),
);
const games = await Promise.all(
  entries.map(async (game) => ({
    game,
    Content: (await render(game)).Content,
    news: (await getEntries(game.data.news))
      .filter((n) => !n.data.draft)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  })),
);
---

<PageLayout page="spiele">
  {games.length === 0 && <p class="empty">Gerade ist kein Spiel eingetragen. Schau im Discord vorbei, was wir planen.</p>}

  {
    games.map(({ game, Content, news }) => (
      <section id={game.id} class="game panel" aria-labelledby={`${game.id}-title`}>
        <header class="head">
          <h2 id={`${game.id}-title`}>{game.data.title}</h2>
          {game.data.recruiting && <span class="badge">Wir suchen Mitspieler:innen</span>}
        </header>

        {game.data.facts.length > 0 && (
          <dl class="facts">
            {game.data.facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="prose">
          <Content />
        </div>

        {game.data.recruiting && (
          <div class="recruit">
            <p>{game.data.recruitingNote ?? 'Du möchtest mitspielen? Melde dich bei uns im Discord.'}</p>
            <a class="btn btn--primary" href={site.discord} target="_blank" rel="noopener noreferrer">
              <Icon name="discord" size={18} /> Join our Discord
            </a>
          </div>
        )}

        {news.length > 0 && (
          <div class="news">
            <h3 class="section-title">News zum Spiel</h3>
            <div class="grid">
              {news.map((entry) => (
                <NewsCard entry={entry} />
              ))}
            </div>
          </div>
        )}
      </section>
    ))
  }
</PageLayout>

<style>
  .empty {
    margin-top: 2rem;
  }

  .game {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .head h2 {
    margin: 0;
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.6rem);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    border: 1px solid rgb(0 255 255 / 0.5);
    border-radius: 999px;
    background: var(--cyan-soft);
    box-shadow: 0 0 14px -4px var(--glow);
  }

  /* pulsierender Punkt */
  .badge::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--glow);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge::before {
      animation: none;
    }
  }

  /* Flex statt Grid: die letzte Zeile füllt sich immer ganz, ohne leere Zellen */
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin: 0 0 1.75rem;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .facts div {
    flex: 1 1 8rem;
    padding: 0.8rem 1rem;
    background: rgb(0 0 0 / 0.55);
  }

  .facts dt {
    margin-bottom: 0.2rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 650;
    color: var(--text);
  }

  .recruit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.1rem 1.25rem;
    border-left: 2px solid var(--cyan);
    background: var(--cyan-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .recruit p {
    flex: 1 1 20rem;
    margin: 0;
    color: var(--text);
  }

  .news {
    margin-top: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
  }
</style>
